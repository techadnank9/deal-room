# Copy to .env.local. Every sponsor key is optional: a missing key falls back to a mock.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Postgres for events; leave empty to use SQLite at data/dealroom.db
DATABASE_URL=
TELEM_API_KEY=
GLASSER_API_KEY=
RUNWARE_API_KEY=
# BAND: key of the director agent, plus ids/keys of each agent (create them in BAND: Agents > Connect remote agent)
BAND_API_KEY=
BAND_AGENTS={"director":{"id":""},"cfo":{"id":"","key":""},"tech":{"id":"","key":""},"procurement":{"id":"","key":""},"analyst":{"id":"","key":""}}
# Optional: path to the bruin binary if not in ~/.local/bin
BRUIN_BIN=
